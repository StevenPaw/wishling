{
  "info": {
    "name": "Wishling API Tests",
    "description": "Collection für das Testen der Wishling API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://wishling.ddev.site",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API Controller Tests",
      "item": [
        {
          "name": "API Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/",
              "host": ["{{baseUrl}}"],
              "path": ["api", ""]
            }
          }
        },
        {
          "name": "API Get Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "123"]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist API Tests",
      "item": [
        {
          "name": "Wishlist API Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", ""]
            }
          }
        },
        {
          "name": "Get All Wishlists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists"]
            }
          }
        },
        {
          "name": "Create Wishlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Wishlist\",\n  \"description\": \"Eine Test-Wunschliste\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists"]
            }
          }
        },
        {
          "name": "Get Wishlist by Hash",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{wishlistHash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{wishlistHash}}"]
            }
          }
        },
        {
          "name": "Create Wish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Wunsch\",\n  \"description\": \"Ein Testwunsch\",\n  \"url\": \"https://example.com\",\n  \"price\": \"29.99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{wishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{wishlistHash}}", "wishes"]
            }
          }
        }
      ]
    },
    {
      "name": "Test API Controller",
      "item": [
        {
          "name": "Test API Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "test", ""]
            }
          }
        }
      ]
    }
  ]
}
