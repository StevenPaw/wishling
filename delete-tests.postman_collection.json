                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.environment.set('testWish2Hash', jsonData.data.hash);",
                  "    console.log('Test Wish #2 Hash: ' + jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Wish für DELETE #2\",\n  \"description\": \"Zweiter Testwunsch zum Löschen\",\n  \"url\": \"https://example.com/delete-test-2\",\n  \"price\": \"45.50\"\n}"
