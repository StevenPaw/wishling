                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.environment.set('testWish1Hash', jsonData.data.hash);",
                  "    console.log('Test Wish #1 Hash: ' + jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Wish für DELETE #1\",\n  \"description\": \"Erster Testwunsch zum Löschen\",\n  \"url\": \"https://example.com/delete-test-1\",\n  \"price\": \"25.99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "Create Test Wish #2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test Wish #2 created', function () {",
                  "    pm.response.to.have.status(201);",
