{
  "info": {
    "name": "Wishling DELETE Tests",
    "description": "Tests für DELETE-Funktionalität der Wishling API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://wishling.ddev.site",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup Tests",
      "item": [
        {
          "name": "Create Wishlist for Testing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wishlist created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.hash).to.exist;",
                  "    pm.environment.set('testWishlistHash', jsonData.data.hash);",
                  "    console.log('Test Wishlist Hash: ' + jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DELETE Test Wishlist {{$timestamp}}\",\n  \"description\": \"Wishlist für DELETE-Tests\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists"]
            }
          }
        },
        {
          "name": "Create Test Wish #1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test Wish #1 created', function () {",
