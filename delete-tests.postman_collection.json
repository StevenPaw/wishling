    {
      "name": "Archive vs Delete Comparison",
      "item": [
        {
          "name": "Create Wish for Archive Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Archive test wish created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('archiveTestWishHash', jsonData.data.hash);",
