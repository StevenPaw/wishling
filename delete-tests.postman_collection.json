              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes/{{archiveTestWishHash}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes", "{{archiveTestWishHash}}", "archive"]
            }
          }
