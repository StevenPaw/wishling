          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes/{{archiveTestWishHash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes", "{{archiveTestWishHash}}"]
            }
          }
        },
