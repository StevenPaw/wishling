    {
      "name": "DELETE Tests",
      "item": [
        {
          "name": "Get Wishes Before Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wishes retrieved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.count).to.be.at.least(2);",
                  "    console.log('Wishes before delete: ' + jsonData.count);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "DELETE Test Wish #1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish deleted successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include('gelöscht');",
                  "    console.log('DELETE response: ' + jsonData.message);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes/{{testWish1Hash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes", "{{testWish1Hash}}"]
            }
          }
        },
        {
          "name": "Verify Wish #1 is Deleted",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish is no longer accessible', function () {",
                  "    pm.response.to.have.status(404);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.error).to.include('nicht gefunden');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes/{{testWish1Hash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes", "{{testWish1Hash}}"]
            }
          }
        },
        {
          "name": "Get Wishes After Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish count reduced by 1', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.count).to.equal(1);",
                  "    console.log('Wishes after delete: ' + jsonData.count);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{testWishlistHash}}", "wishes"]
            }
          }
        }
      ]
    },
