              "mode": "raw",
              "raw": "{\n  \"title\": \"Archive vs Delete Test\",\n  \"description\": \"Für Vergleich Archive/Delete\",\n  \"url\": \"https://example.com/archive-test\",\n  \"price\": \"33.33\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{testWishlistHash}}/wishes",
