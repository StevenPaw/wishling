{
  "info": {
    "name": "Wishling Archive Tests",
    "description": "Tests für Archivierungsfunktionalität der Wishling API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://wishling.ddev.site",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup Archive Tests",
      "item": [
        {
          "name": "Create Archive Test Wishlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Archive test wishlist created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.environment.set('archiveTestWishlistHash', jsonData.data.hash);",
                  "    console.log('Archive Test Wishlist Hash: ' + jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Archive Tests {{$timestamp}}\",\n  \"description\": \"Wishlist für Archivierungstests\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists"]
            }
          }
        },
        {
          "name": "Create Test Wish 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test wish 1 created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('archiveWish1Hash', jsonData.data.hash);",
                  "    console.log('Archive Test Wish 1 Hash: ' + jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Archive Test Wish 1\",\n  \"description\": \"Erster Wunsch für Archivtests\",\n  \"url\": \"https://example.com/archive-1\",\n  \"price\": \"19.99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "Create Test Wish 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test wish 2 created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('archiveWish2Hash', jsonData.data.hash);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Archive Test Wish 2\",\n  \"description\": \"Zweiter Wunsch für Archivtests\",\n  \"url\": \"https://example.com/archive-2\",\n  \"price\": \"29.99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        }
      ]
    },
    {
      "name": "Archive Functionality Tests",
      "item": [
        {
          "name": "Get Active Wishes (Before Archive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Shows 2 active wishes initially', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.count).to.equal(2);",
                  "    pm.expect(jsonData.stats.active).to.equal(2);",
                  "    pm.expect(jsonData.stats.archived).to.equal(0);",
                  "    console.log('Before archive - Active: ' + jsonData.stats.active + ', Archived: ' + jsonData.stats.archived);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "Archive Wish 1 (POST Method)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish archived successfully via POST', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include('archiviert');",
                  "    pm.expect(jsonData.data.archived).to.be.true;",
                  "    console.log('Wish 1 archived via POST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes/{{archiveWish1Hash}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes", "{{archiveWish1Hash}}", "archive"]
            }
          }
        },
        {
          "name": "Get Active Wishes (After Archive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Shows 1 active wish after archiving', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.count).to.equal(1);",
                  "    pm.expect(jsonData.stats.active).to.equal(1);",
                  "    pm.expect(jsonData.stats.archived).to.equal(1);",
                  "    console.log('After archive - Active: ' + jsonData.stats.active + ', Archived: ' + jsonData.stats.archived);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "Get Archived Wishes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Shows archived wishes correctly', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.count).to.equal(1);",
                  "    pm.expect(jsonData.stats.showing).to.equal('archived');",
                  "    pm.expect(jsonData.data[0].archived).to.be.true;",
                  "    console.log('Archived wishes view working correctly');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes?archived=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"],
              "query": [
                {
                  "key": "archived",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Archive Wish 2 via PUT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish archived and updated via PUT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.archived).to.be.true;",
                  "    pm.expect(jsonData.data.title).to.include('Erfüllt');",
                  "    console.log('Wish 2 archived and updated via PUT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Archive Test Wish 2 - Erfüllt ✅\",\n  \"description\": \"Wurde erfüllt und archiviert\",\n  \"archived\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes/{{archiveWish2Hash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes", "{{archiveWish2Hash}}"]
            }
          }
        },
        {
          "name": "Verify All Wishes Archived",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('No active wishes remaining', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.count).to.equal(0);",
                  "    pm.expect(jsonData.stats.active).to.equal(0);",
                  "    pm.expect(jsonData.stats.archived).to.equal(2);",
                  "    console.log('All wishes successfully archived');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        }
      ]
    },
    {
      "name": "Unarchive Tests",
      "item": [
        {
          "name": "Unarchive Wish 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish unarchived successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include('dearchiviert');",
                  "    pm.expect(jsonData.data.archived).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes/{{archiveWish1Hash}}/unarchive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes", "{{archiveWish1Hash}}", "unarchive"]
            }
          }
        },
        {
          "name": "Verify Unarchive Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unarchived wish appears in active list', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.count).to.equal(1);",
                  "    pm.expect(jsonData.stats.active).to.equal(1);",
                  "    pm.expect(jsonData.stats.archived).to.equal(1);",
                  "    console.log('Unarchive successful - Active: ' + jsonData.stats.active);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes"]
            }
          }
        },
        {
          "name": "Unarchive via PUT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wish unarchived via PUT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.archived).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"archived\": false,\n  \"title\": \"Archive Test Wish 2 - Wieder aktiv\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/wishlists/{{archiveTestWishlistHash}}/wishes/{{archiveWish2Hash}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "wishlists", "{{archiveTestWishlistHash}}", "wishes", "{{archiveWish2Hash}}"]
            }
          }
        }
      ]
    }
  ]
}
