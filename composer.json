{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "require": {
        "php": "^8.1",
        "silverstripe/recipe-plugin": "~2.1.0",
        "silverstripe/framework": "^6.1",
        "silverstripe/admin": "^3.1",
        "silverstripe/assets": "^3.1",
        "silverstripe/asset-admin": "^3.1",
        "silverstripe/login-forms": "^6.1",
        "colymba/gridfield-bulk-editing-tools": "^5.1",
        "jonom/focuspoint": "^6.0",
        "undefinedoffset/sortablegridfield": "^3.0",
        "silverstripe/recipe-core": "^6.1",
        "atwx/silverstripe-vitehelper": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "extra": {
        "expose": [
            "app/client/dist",
            "app/client/icons",
            "app/client/images"
        ],
        "resources-dir": "_resources",
        "project-files-installed": [
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
